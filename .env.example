# Environment Configuration for ResearchMind AI

# Application Settings
PROJECT_NAME="ResearchMind AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="researchmind_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
DATABASE_URL="sqlite:///./researchmind.db"
# For Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@postgres:5432/researchmind"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"

# Vector Store Settings
# Supported: chromadb, faiss, qdrant
DEFAULT_VECTOR_STORE="chromadb"
CHROMA_PERSIST_DIRECTORY="./vectorstore/chroma"
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# Embedding Settings
# Supported: BAAI/bge-small-en-v1.5, intfloat/e5-small-v2, sentence-transformers/all-MiniLM-L6-v2, hku-nlp/instructor-base, nomic-ai/nomic-embed-text-v1
DEFAULT_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# Chunking Defaults
DEFAULT_CHUNKING_STRATEGY="recursive" # recursive, semantic, token, fixed
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200

# Retrieval Defaults
DEFAULT_RETRIEVAL_STRATEGY="hybrid" # cosine, mmr, hybrid, cross_encoder, multi_query

# Ollama / LLM Settings
OLLAMA_BASE_URL="http://localhost:11434"
DEFAULT_LLM_MODEL="llama3.1"
OLLAMA_TIMEOUT=120.0

# Optional Cloud APIs (Fallback)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
